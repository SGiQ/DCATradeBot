# --- Alpaca (paper) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- Alpaca (live) — only used when LIVE_TRADING=true ---
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Database (Neon/Supabase Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/dca

# --- Strategy sizing ---
BASE_DAILY_USD=50
EXTRA_DAILY_USD=25
DAILY_CAP_USD=100
# Take-profit threshold (partial sell when gain >= this fraction AND regime=downtrend).
# Intentionally wide — partial profit-taking on pullbacks locks in gains that grow
# bigger on the bounce. Lower this only if you've added regime detection.
TP_PCT=2.0
SELL_FRACTION=0.25
# Death-cross sell: fraction of position exited the day sma50 crosses
# BELOW sma200. Fires only on the actual cross — typically 1-3x per cycle.
DEATH_CROSS_SELL_FRACTION=0.5
# Golden-cross redeploy: fraction of available cash deployed on the day
# sma50 crosses ABOVE sma200. The symmetric BUY partner to the death-cross
# SELL — together they make the bot a mechanical trader (out on death cross,
# in on golden cross).
GOLDEN_CROSS_BUY_FRACTION=0.5
# Stop-loss: catastrophic exit only (0.70 = full exit at -70% unrealised loss).
# Intentionally wide — tighter stops lock in losses on normal crypto drawdowns
# that DCA would otherwise recover from. Backtests show tight stops are value-destroying.
STOP_LOSS_PCT=0.70

# --- Cron ---
DAILY_CRON=0 13 * * *
TZ=UTC

# --- Safety ---
LIVE_TRADING=false
DAILY_LIVE_CAP_USD=100
APPROVAL_TIMEOUT_MIN=30
# Required for live trading: 32+ char random secret for HMAC-signed approve/reject URLs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_SECRET=
# --- Approvals: NIA assistant integration ---
# Optional: when set, DCATradeBot POSTs each new approval intent here as JSON.
# Leave unset to skip push notifications (NIA can still poll via its DCA tools).
NIA_WEBHOOK_URL=
PUBLIC_APPROVE_BASE_URL=

# --- Status push: NIA dashboard pill ---
# Optional: after each runOnce() the bot POSTs a snapshot {portfolio, cash, open_trades, ...}
# to NIA's /agent-message/status so the DCA pill on the dashboard stays fresh.
# Set both vars or the push silently no-ops.
# NIA_WEBHOOK_SECRET must equal NIA's TRADEBOT_WEBHOOK_SECRET env var.
NIA_STATUS_URL=
NIA_WEBHOOK_SECRET=

# --- Dashboard ---
UI_ENABLED=true
UI_PORT=8080
UI_USER=admin
UI_PASS=change-me-long-random

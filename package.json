{
  "name": "dca-trade-bot",
  "version": "0.1.0",
  "description": "Daily crypto DCA bot with momentum/trend overlay (BTC + ETH) on Alpaca",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/worker/cron.js",
    "ui:dev": "tsx src/server/ui.ts",
    "run:once": "tsx src/worker/dailyRun.ts",
    "approve": "tsx src/safety/approveCli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "undici": "^6.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
